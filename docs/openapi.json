    "/api/v1/today/": {
      "get": {
        "tags": [
          "Today"
        ],
        "summary": "Get Today",
        "description": "Fetch today's habits based on active plan.\n\nReturns:\n- tasks: list of today's habits with status and points\n- summary: live preview of progress (earned_points, completion_pct, etc.)\n- backfill: info about auto-processed missed days\n\nFlow:\n1. Resolve local date using user's timezone\n2. Auto-process any missed past days\n3. Initialize today's logs if needed\n4. Return tasks + live summary + backfill info",
        "operationId": "get_today_api_v1_today__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse_TodayResponse_"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
